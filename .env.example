# AgentOS environment configuration (all values are optional).
# Copy to `.env` to override; the file is git-ignored.

# --- backend ---
# Port and bind address of the AgentOS API server.
AGENTOS_PORT=4317
AGENTOS_HOST=0.0.0.0

# Directory holding persisted settings, the memory store and notes.
# Defaults to ./data. Set this to keep secrets outside the repo.
AGENTOS_DATA_DIR=./data

# Root directory that filesystem tools may access (read tools are confined here).
# Defaults to the process working directory.
AGENTOS_WORKSPACE_DIR=.

# Comma-separated list of extra browser origins allowed to call the API.
# localhost and *.e2b.app preview hosts are always allowed.
AGENTOS_ALLOWED_ORIGINS=

# Log level used until settings.json is loaded (debug|info|warn|error).
AGENTOS_LOG_LEVEL=info
