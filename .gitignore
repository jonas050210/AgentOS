# dependencies
node_modules/

# build output
dist/
dist-server/
*.tsbuildinfo

# runtime data (settings, memory, notes) — user-specific, may contain secrets
data/

# environment
.env
.env.local
.env.*.local

# logs & OS noise
*.log
npm-debug.log*
.DS_Store
Thumbs.db

# test & tooling caches
coverage/
.vitest/

# python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# codemind runtime data (created by the app, never part of the source)
codemind.db
codemind.db-shm
codemind.db-wal
*/logs/codemind.jsonl*
